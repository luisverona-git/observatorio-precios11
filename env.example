# Copia este archivo como .env para desarrollo local (NO subas .env a GitHub)
PORT=3000
NODE_ENV=development
# Cadena de conexion PostgreSQL (con PostGIS). Neon o Supabase (usar "Session pooler") en la nube
DATABASE_URL=postgres://obs:obs@127.0.0.1:5432/observatorio
# true/false. Se activa solo si la URL es de Supabase/Neon o dice sslmode=require
DATABASE_SSL=
# Clave para firmar sesiones (cadena larga y aleatoria)
JWT_SECRET=
# Contrasena de las cuentas demo que se crean al iniciar la primera vez
DEMO_PASSWORD=Observatorio2026
